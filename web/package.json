{
  "name": "swarsadhana-web",
  "version": "1.0.0",
  "description": "SwarSadhana Web App - Indian Classical Music Practice",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "lint": "eslint js/**/*.js",
    "typecheck": "echo 'No TypeScript in web version'",
    "serve:test": "python3 -m http.server 8081"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@vitest/coverage-v8": "^1.3.0",
    "eslint": "^8.57.0",
    "happy-dom": "^13.3.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
